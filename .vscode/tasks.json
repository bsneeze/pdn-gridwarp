{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "command": "dotnet build (Get-ChildItem -Filter *.sln).FullName -c Debug /property:GenerateFullPaths=true /consoleloggerparameters:NoSummary",
            "options": {
                "cwd": "${workspaceFolder}",
                "shell": {
                    "executable": "powershell.exe",
                    "args": ["-NoProfile", "-Command"]
                }
            },
            "problemMatcher": "$msCompile",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
